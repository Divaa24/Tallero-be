generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MECHANIC
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CHECKED_IN
  IN_PROGRESS
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

enum PhotoType {
  BEFORE
  AFTER
}

enum PaymentMethod {
  CASH
  TRANSFER
  QRIS
}

enum PaymentStatus {
  UNPAID
  PAID
}

model User {
  id           Int           @id @default(autoincrement())
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(100)
  password     String        @db.VarChar(255)
  phone        String        @db.VarChar(20)
  address      String?       @db.Text
  avatar       String?       @map("avatar_url")
  role         Role          @default(CUSTOMER)
  isActive     Boolean       @default(true) @map("is_active")
  isVerified   Boolean       @default(false) @map("is_verified")
  otpCode      String?       @map("otp_code") @db.VarChar(10)
  otpExpiresAt DateTime?     @map("otp_expires_at")
  vehicles     Vehicle[]
  bookings     Booking[]     @relation("CustomerBookings")
  assignedJobs Booking[]     @relation("MechanicBookings")
  reviews      Review[]
  statusLogs   BookingLog[]  @relation("ActorLogs")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Outlet {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(100)
  address   String    @db.Text
  phone     String?   @db.VarChar(20)
  latitude  Decimal   @db.Decimal(10, 8)
  longitude Decimal   @db.Decimal(11, 8)
  isActive  Boolean   @default(true) @map("is_active")
  bookings  Booking[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("outlets")
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(100)
  services Service[]

  @@map("categories")
}

model Service {
  id            Int       @id @default(autoincrement())
  categoryId    Int       @map("category_id")
  category      Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String    @db.VarChar(100)
  price         Decimal   @db.Decimal(12, 2)
  estimatedTime Int       @map("estimated_time")
  bookings      Booking[]

  @@map("services")
}

model Vehicle {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  licensePlate String    @map("license_plate") @db.VarChar(20)
  brand        String    @db.VarChar(50)
  model        String    @db.VarChar(50)
  type         String    @default("Car") @db.VarChar(20)
  year         Int
  bookings     Booking[]

  @@map("vehicles")
}

model Booking {
  id            Int            @id @default(autoincrement())
  bookingCode   String         @unique @map("booking_code") @db.VarChar(50)
  userId        Int            @map("user_id")
  user          User           @relation("CustomerBookings", fields: [userId], references: [id], onDelete: Cascade)
  outletId      Int            @map("outlet_id")
  outlet        Outlet         @relation(fields: [outletId], references: [id], onDelete: Cascade)
  vehicleId     Int            @map("vehicle_id")
  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  serviceId     Int            @map("service_id")
  service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  mechanicId    Int?           @map("mechanic_id")
  mechanic      User?          @relation("MechanicBookings", fields: [mechanicId], references: [id], onDelete: SetNull)
  bookingDate   DateTime       @map("booking_date")
  status        BookingStatus  @default(PENDING)
  customerNotes String?        @map("customer_notes") @db.Text
  adminNotes    String?        @map("admin_notes") @db.Text
  paymentMethod PaymentMethod? @map("payment_method")
  paymentStatus PaymentStatus  @default(UNPAID) @map("payment_status")
  totalPrice    Decimal?       @map("total_price") @db.Decimal(12, 2)
  photos        BookingPhoto[]
  statusLogs    BookingLog[]
  review        Review?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@map("bookings")
}

model BookingPhoto {
  id        Int       @id @default(autoincrement())
  bookingId Int       @map("booking_id")
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  photoPath String    @map("photo_path") @db.Text
  type      PhotoType
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("booking_photos")
}

model BookingLog {
  id        Int           @id @default(autoincrement())
  bookingId Int           @map("booking_id")
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actorId   Int           @map("actor_id")
  actor     User          @relation("ActorLogs", fields: [actorId], references: [id], onDelete: Cascade)
  status    BookingStatus
  notes     String?       @db.Text
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("booking_logs")
}

model Review {
  id        Int      @id @default(autoincrement())
  bookingId Int      @unique @map("booking_id")
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      @default(5)
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}